NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only — required for checkout order writes, stock updates, and webhooks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Digits only, with country code (example Nigeria: 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678

# Paystack (NGN). Register webhook: {NEXT_PUBLIC_SITE_URL}/api/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Fez Delivery (sandbox by default)
FEZ_SECRET_KEY=your-fez-secret-key
FEZ_BASE_URL=https://apisandbox.fezdelivery.co/v1
FEZ_DEFAULT_WEIGHT_KG=1

# Free shipping threshold in Naira (major units)
NEXT_PUBLIC_FREE_SHIPPING_NGN=150000

# ZeptoMail (transactional email)
# Send Mail Token from ZeptoMail → Mail Agents → SMTP/API
ZEPTOMAIL_SEND_TOKEN=your-zeptomail-send-token
ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=Teeshogs
# Optional override (default: https://api.zeptomail.com/v1.1/email)
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Where admin order/contact alerts are sent (defaults to ZEPTOMAIL_FROM_EMAIL)
ORDER_NOTIFY_EMAIL=orders@yourdomain.com
